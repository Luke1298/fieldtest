{:paths ["script"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [fieldtest.lint :as lint])
  :init (def example-dirs
          (->> (fs/glob "examples" "*/{src,test}")
               (map str)
               sort))

  test:jvm {:doc "Run the JVM test suite"
            :task (clojure "-M:test" "-d" "test")}
  test:node {:doc "Compile and run the shadow-cljs node test build"
             :task (shell "npm test")}
  test:nbb {:doc "Run the test suite under nbb"
            :task (shell "npx nbb -m fieldtest.nbb-test-runner")}
  test:nbb-consumer {:doc "A downstream nbb project using fieldtest via :local/root"
                     ;; nbb caches :local/root deps by nbb.edn's hash, so clear it to test current src.
                     :task (do (fs/delete-tree "test-consumers/nbb/.nbb")
                               (shell {:dir "test-consumers/nbb"} "npx --prefix ../.. nbb -m consumer.main"))}
  test {:doc "Run every runtime's test suite"
        :task (do (run 'test:jvm) (run 'test:node) (run 'test:nbb) (run 'test:nbb-consumer))}

  lint:kondo {:doc "clj-kondo over sources and tests"
              :task (apply clojure "-M:kondo" "--lint" "src" "test" "script" example-dirs)}
  lint:fmt {:doc "cljfmt check"
            :task (apply clojure "-M:cljfmt" "check" "src" "test" "script" "build.clj" "bb.edn" "deps.edn" example-dirs)}
  fmt {:doc "cljfmt fix"
       :task (apply clojure "-M:cljfmt" "fix" "src" "test" "script" "build.clj" "bb.edn" "deps.edn" example-dirs)}
  lint:no-infra {:doc "Fail on environment, cloud or database access under src/, and on cheshire outside #?(:clj ...)"
                 :task (lint/no-infra! "src")}
  lint {:doc "All linters"
        :task (do (run 'lint:kondo) (run 'lint:fmt) (run 'lint:no-infra))}

  ci {:doc "Lint and test"
      :task (do (run 'lint) (run 'test))}}}
